{
  "headers": [
    {
      "source": "/api",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, OPTIONS" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, OPTIONS" }
      ]
    }
  ],
  "functions": {
    "api/*.js": {
      "includeFiles": "{src/data/mockState.json,scraper/fieldsConfig.json}"
    }
  }
}
